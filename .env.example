# Database Configuration (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://terralux:terralux_secret@db:5432/terralux_db

# Local fallback if testing without Docker:
# DATABASE_URL=sqlite:///./terralux.db

# JWT & Security
JWT_SECRET=terralux_super_secret_jwt_key_hackathon_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Sovereign EU Storage (MinIO S3 Compatible)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=terralux_minio_admin
MINIO_SECRET_KEY=terralux_minio_secret_2026
MINIO_BUCKET=terralux-data
MINIO_SECURE=false

# Sovereign Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# Server Config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=*
